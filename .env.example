# ============================================
# Industrial AI Energy Optimization Platform
# Environment Configuration
# ============================================

# Application
APP_NAME=EnergyOptimizationPlatform
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Database (PostgreSQL + TimescaleDB)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=energy_optimization
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/energy_optimization

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# AWS IoT Core
AWS_IOT_ENDPOINT=your-iot-endpoint.iot.us-east-1.amazonaws.com
AWS_IOT_CERT_PATH=./certs/certificate.pem.crt
AWS_IOT_KEY_PATH=./certs/private.pem.key
AWS_IOT_ROOT_CA_PATH=./certs/AmazonRootCA1.pem

# AWS SQS
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/energy-sensor-queue
SQS_DEAD_LETTER_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/energy-sensor-dlq

# MQTT Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=factory/sensors

# SCADA Configuration
SCADA_HOST=192.168.1.100
SCADA_PORT=4840
SCADA_USERNAME=operator
SCADA_PASSWORD=scada-password
SCADA_WRITEBACK_ENABLED=false

# AI Engine
AI_ANOMALY_THRESHOLD=0.85
AI_MODEL_PATH=./models
AI_RETRAIN_INTERVAL_HOURS=24

# Dashboard
DASHBOARD_PORT=8501
DASHBOARD_REFRESH_INTERVAL=5

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
